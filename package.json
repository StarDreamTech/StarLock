{
  "name": "starlock",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/browser",
    "packages/vue",
    "packages/react",
    "examples/playground"
  ],
  "scripts": {
    "dev": "npm run build:sdk && vite --config examples/playground/vite.config.ts --host 127.0.0.1 --port 5178 --strictPort",
    "build": "vue-tsc --noEmit && npm run build:sdk && npm run build:site && npm run build:hosted",
    "build:site": "vite build --config examples/playground/vite.config.ts && node scripts/prerender-home.mjs && node scripts/check-static-site.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build:sdk": "vite build --config packages/browser/vite.config.ts",
    "dev:hosted": "vite --config examples/hosted/vite.config.ts --host 127.0.0.1 --port 5179 --strictPort",
    "build:hosted": "vite build --config examples/hosted/vite.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
