{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@starlock/core": [
        "packages/core/src/index.ts"
      ],
      "@starlock/vue": [
        "packages/vue/src/index.ts"
      ],
      "@starlock/browser": [
        "packages/browser/src/loader.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.vue",
    "examples/**/*.ts",
    "examples/**/*.vue",
    "docs/examples/**/*.vue"
  ]
}
